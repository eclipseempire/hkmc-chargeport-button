<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nemesis.chargeport"
    android:versionCode="1"
    android:versionName="1.0">
  <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
  <uses-permission android:name="com.hkmc.permission.BROADCASTRECEIVER" />
  <application android:label="Charge Port Button" android:allowBackup="false">
    <activity android:name=".MainActivity" android:exported="true" android:label="Charge Port Button">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
    <receiver android:name=".ChargeReceiver" android:exported="true">
      <intent-filter>
        <action android:name="com.hkmc.intent.action.MAP_SHORTCUT" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
